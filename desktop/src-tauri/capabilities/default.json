{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Native notifications and opening https links in the system browser. Nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    }
  ]
}
